# Leave VITE_API_BASE empty in dev so requests stay relative and go through
# the Vite proxy (see vite.config.js) -- this keeps things working whether the
# client is reached via localhost or a port-forwarded/remote host. Set it to
# an absolute URL only for a production build served separately from the API.
VITE_GOOGLE_MAPS_BROWSER_KEY=YOUR_BROWSER_KEY_HERE
VITE_API_BASE=
