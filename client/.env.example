VITE_GOOGLE_MAPS_BROWSER_KEY=YOUR_BROWSER_KEY_HERE

# Leave VITE_BASE_PATH unset in dev (Vite serves from '/').
# Set to '/weathermapper/' for production builds so asset URLs resolve
# correctly under the nginx subpath. Pass as an env var at build time:
#   VITE_BASE_PATH=/weathermapper/ npm run build
# VITE_BASE_PATH=
